# =========================================================
# WEEK 8 · CHROMA FEATURES
# Change only this line:
DATA_OBJECT <- "all_top_songs_2018_2025"
# =========================================================
library(tidyverse)
library(spotifyr)
library(compmus)
# ---------------------------------------------------------
# 0. Load your data object from the RStudio Environment
# ---------------------------------------------------------
df_all <- get(DATA_OBJECT) |>
rename_with(~ tolower(gsub("[^A-Za-z0-9]+", "_", .x))) |>
mutate(
spotify_id = str_remove(track_uri, "^spotify:track:")
)
# ---------------------------------------------------------
# 1. Helper function exactly in the week 8 spirit:
#    pull Spotify audio analysis, keep segments,
#    unnest them, and keep only start/duration/pitches
# ---------------------------------------------------------
get_segments <- function(track_id) {
get_tidy_audio_analysis(track_id) |>
select(segments) |>
unnest(segments) |>
select(start, duration, pitches)
}
safe_get_segments <- purrr::possibly(get_segments, otherwise = NULL)
# ---------------------------------------------------------
# 2. Automatically choose the #1 song of each year
#    Assumes your merged file preserves rank order within year
# ---------------------------------------------------------
top1_by_year <- df_all |>
group_by(year) |>
slice(1) |>
ungroup() |>
mutate(
label = paste0(track_name, " — ", artist_name_s_, " (", year, ")")
) |>
select(year, track_name, artist_name_s_, track_uri, spotify_id, label)
print(top1_by_year)
# ---------------------------------------------------------
# 3. Chromagram helper
#    Week 8 uses chroma normalization + long-format chroma
# ---------------------------------------------------------
make_chromagram <- function(track_id, label_text, norm = "euclidean") {
segs <- get_segments(track_id)
segs |>
mutate(pitches = map(pitches, compmus_normalise, norm)) |>
compmus_gather_chroma() |>
ggplot(aes(
x = start + duration / 2,
width = duration,
y = pitch_class,
fill = value
)) +
geom_tile() +
scale_fill_viridis_c() +
theme_minimal() +
labs(
title = paste("Chromagram:", label_text),
x = "Time (s)",
y = NULL,
fill = "Magnitude"
)
}
# ---------------------------------------------------------
# 4. Make one chromagram for the #1 song of each year
# ---------------------------------------------------------
chromagram_plots <- map2(
top1_by_year$spotify_id,
top1_by_year$label,
~ make_chromagram(.x, .y, norm = "euclidean")
)
