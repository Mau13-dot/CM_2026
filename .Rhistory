library(tidyverse)
df_all <- all_top_songs_2018_2025 |>
rename_with(~ tolower(gsub("[^A-Za-z0-9]+", "_", .x)))
key_labels <- c(
"C", "C#", "D", "D#", "E", "F",
"F#", "G", "G#", "A", "A#", "B"
)
key_heatmap <- df_all |>
filter(!is.na(key), key %in% 0:11) |>
mutate(
key_name = factor(key_labels[key + 1], levels = key_labels)
) |>
count(year, key_name) |>
group_by(year) |>
mutate(prop = n / sum(n)) |>
ungroup()
ggplot(key_heatmap, aes(x = factor(year), y = key_name, fill = prop)) +
geom_tile(color = "white") +
scale_fill_viridis_c(labels = scales::percent_format(accuracy = 1)) +
theme_minimal() +
labs(
title = "Key distribution by year",
x = "Year",
y = "Key",
fill = "Share of songs"
)
library(tidyverse)
df_all <- all_top_songs_2018_2025 |>
rename_with(~ tolower(gsub("[^A-Za-z0-9]+", "_", .x)))
key_labels <- c(
"C", "C#", "D", "D#", "E", "F",
"F#", "G", "G#", "A", "A#", "B"
)
# -----------------------------
# 1. Prepare key and mode labels
# -----------------------------
df_pitch <- df_all |>
filter(!is.na(year)) |>
mutate(
key_name = case_when(
!is.na(key) & key %in% 0:11 ~ key_labels[key + 1],
TRUE ~ NA_character_
),
mode_name = case_when(
mode == 1 ~ "Major",
mode == 0 ~ "Minor",
TRUE ~ NA_character_
)
)
# -----------------------------
# 2. Key-by-year heatmap
# -----------------------------
key_heatmap <- df_pitch |>
filter(!is.na(key_name)) |>
count(year, key_name) |>
group_by(year) |>
mutate(prop = n / sum(n)) |>
ungroup() |>
mutate(
key_name = factor(key_name, levels = key_labels)
)
# -----------------------------
# 3. Get the #1 song of each year
# -----------------------------
top1_by_year <- df_pitch |>
group_by(year) |>
slice(1) |>
ungroup() |>
select(
year,
track_name,
artist_name_s_,
key_name,
mode_name
) |>
rename(
top1_key = key_name,
top1_mode = mode_name
)
# -----------------------------
# 4. Most common key of each year
# -----------------------------
year_key_summary <- df_pitch |>
filter(!is.na(key_name)) |>
count(year, key_name) |>
group_by(year) |>
summarise(
most_common_key = paste(key_name[n == max(n)], collapse = ", "),
.groups = "drop"
)
# -----------------------------
# 5. Dominant mode of each year
# -----------------------------
year_mode_summary <- df_pitch |>
filter(!is.na(mode_name)) |>
count(year, mode_name) |>
group_by(year) |>
summarise(
dominant_mode = paste(mode_name[n == max(n)], collapse = ", "),
.groups = "drop"
)
# -----------------------------
# 6. Compare #1 song to whole year
# -----------------------------
top1_vs_year <- top1_by_year |>
left_join(year_key_summary, by = "year") |>
left_join(year_mode_summary, by = "year") |>
mutate(
key_match = str_detect(most_common_key, fixed(top1_key)),
mode_match = str_detect(dominant_mode, fixed(top1_mode)),
song = paste0(track_name, " — ", artist_name_s_)
) |>
select(
year,
song,
top1_key,
most_common_key,
key_match,
top1_mode,
dominant_mode,
mode_match
)
top1_vs_year
# -----------------------------
# 7. Plot: yearly key heatmap with #1-song key overlaid
# -----------------------------
top1_key_points <- top1_by_year |>
filter(!is.na(top1_key)) |>
mutate(
top1_key = factor(top1_key, levels = key_labels)
)
ggplot(key_heatmap, aes(x = factor(year), y = key_name, fill = prop)) +
geom_tile(color = "white") +
geom_point(
data = top1_key_points,
aes(x = factor(year), y = top1_key),
inherit.aes = FALSE,
shape = 21,
size = 4,
stroke = 1,
colour = "red",
fill = NA
) +
scale_fill_viridis_c(labels = scales::percent_format(accuracy = 1)) +
theme_minimal() +
labs(
title = "Key distribution by year, with each #1 song highlighted",
subtitle = "Red circles mark the key of the #1 song in each year",
x = "Year",
y = "Key",
fill = "Share of songs"
)
library(tidyverse)
df_all <- all_top_songs_2018_2025 |>
rename_with(~ tolower(gsub("[^A-Za-z0-9]+", "_", .x)))
selected_tracks <- tribble(
~year, ~track_name_unique,
2018, "My City",
2019, "New Light_2019",
2020, "Blinding Lights_2020",
2021, "Dolla Dolla Bill",
2022, "Ojitos Lindos_2022",
2023, "Daylight",
2024, "Save Your Tears",
2025, "NUEVAYoL"
)
plot_df <- df_all |>
left_join(
selected_tracks |> mutate(selected = TRUE),
by = c("year", "track_name_unique")
) |>
mutate(
selected = if_else(is.na(selected), FALSE, selected),
label = if_else(selected, paste0(year, " — ", track_name), NA_character_)
)
ggplot(plot_df, aes(x = factor(year), y = energy)) +
geom_jitter(
width = 0.18,
height = 0,
colour = "grey75",
alpha = 0.45,
size = 2
) +
geom_point(
data = filter(plot_df, selected),
aes(size = popularity, colour = factor(year)),
alpha = 0.95
) +
geom_text(
data = filter(plot_df, selected),
aes(label = track_name),
nudge_x = 0.18,
hjust = 0,
size = 3,
check_overlap = TRUE,
colour = "black"
) +
scale_colour_viridis_d() +
scale_size(range = c(3, 6)) +
coord_cartesian(clip = "off") +
theme_classic() +
theme(
plot.margin = margin(5.5, 80, 5.5, 5.5)
) +
labs(
title = "Selected tracks for timbre analysis within the full corpus",
subtitle = "Grey points show all submitted tracks; coloured points show the yearly #1 songs used for cepstrograms",
x = "Year",
y = "Energy",
colour = "Year",
size = "Popularity"
)
